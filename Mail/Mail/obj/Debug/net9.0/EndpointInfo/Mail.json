{
  "openapi": "3.0.4",
  "info": {
    "title": "Mail",
    "version": "1.0"
  },
  "paths": {
    "/api/Mail/generate": {
      "post": {
        "tags": [
          "Mail"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "Image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "AccessToken": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "Image": {
                  "style": "form"
                },
                "AccessToken": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Mail/send": {
      "post": {
        "tags": [
          "Mail"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMailRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMailRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SendMailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SendMailRequest": {
        "type": "object",
        "properties": {
          "hrEmail": {
            "type": "string",
            "nullable": true
          },
          "subject": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string",
            "nullable": true
          },
          "senderEmail": {
            "type": "string",
            "nullable": true
          },
          "appPassword": {
            "type": "string",
            "nullable": true
          },
          "accessToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}